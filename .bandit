# Bandit configuration.
#
# This file is auto-discovered by `bandit -r <targets>`. Config in
# pyproject.toml under [tool.bandit] is silently ignored by bandit, which is
# why this file exists.
#
# Docs: https://bandit.readthedocs.io/en/latest/config.html

[bandit]
# B101 assert_used       - asserts are stripped under `python -O`; production
#                          code must raise instead. Tests are excluded anyway.
# B601/B603/B607 subprocess - operational tooling legitimately shells out
#                          (Makefile, k3d, kubectl) and always uses argv lists.
# B104 hardcoded_bind_all_interfaces - 0.0.0.0 is intentional for network listeners
# B110 try_except_pass - intentional silence in flow_key property parser
skips = ["B101", "B104", "B110", "B601", "B603", "B607"]

exclude_dirs = [
    "./tests",
    "./scripts",
    "./.venv",
    "./venv",
    "./data",
]

# Report at Medium and above in CI; run `bandit -r . -ll` locally to see all.
# Confidence: High only, to avoid noise from speculative matches.